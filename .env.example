# ---------- Discord ----------
DISCORD_CLIENT_ID=
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_ADMIN_ID=
# Channel the bot creates private monitoring threads in
DISCORD_THREAD_CHANNEL_ID=
# Channel the slash commands are allowed in (threads are always allowed)
DISCORD_COMMAND_CHANNEL_ID=

# ---------- MongoDB ----------
MONGODB_URI=mongodb://mongodb:27018/vinted

# ---------- Channels and permissions ----------
ALLOW_USER_TO_CREATE_PRIVATE_CHANNELS=1
USER_MAX_PRIVATE_CHANNELS_DEFAULT=5
ENABLE_CHANNEL_INACTIVITY=0
CHANNEL_INACTIVITY_HOURS=24
CHANNEL_INACTIVITY_DELETE_HOURS=48

# ---------- Vinted ----------
# Domain extension of the Vinted site to watch, eg. fr, de, cz, co.uk
VINTED_API_DOMAIN_EXTENSION=fr
# How often every channel is checked, in seconds
MONITOR_INTERVAL_SECONDS=60
# How many item details are fetched in parallel
ALGORITHM_CONCURRENT_REQUESTS=3
ALGORITHM_FILTER_ZERO_STARS_PROFILES=0
# Must be present even when empty, the value is split on commas
BLACKLISTED_COUNTRIES_CODES=

# ---------- Proxies ----------
# With USE_WEBSHARE=0 the proxies are read from proxies.txt
# (one per line, ip:port:user:password). An empty file means direct requests.
USE_WEBSHARE=0
WEBSHARE_API_KEY=

# ---------- Debugging ----------
DEV_MODE=0
DUMP_LOGS=0
ALLOW_MONGO_EXPRESS=0
